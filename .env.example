# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Salin file ini menjadi .env.local dan isi nilai kredensial Anda.
# JANGAN PERNAH mengisi kunci rahasia asli di file ini!
# ==============================================================================

# Supabase API (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email Bisnis Tujuan (Penerima inquiry dari form contact)
BUSINESS_EMAIL=your-business-email@example.com

# Kredensial Custom SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@example.com

# Opsional: Jika menggunakan Supabase Edge Function
# SUPABASE_EDGE_FUNCTION_NAME=send-contact-email
